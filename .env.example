# Cristopher AI - Variáveis de Ambiente

# Camada 1: LLM (Diretor de Arte / Expansão de Prompt)
OPENAI_API_KEY=
# ou ANTHROPIC_API_KEY=
# ou GEMINI_API_KEY=

# Camada 2: Geração de Imagem
# Opção A: Fal.ai (Flux.1 Dev / Schnell)
FAL_KEY=

# Opção B: Ideogram (Melhor para textos e tipografia)
IDEOGRAM_API_KEY=

# Opção C: Replicate (Alternativa para Flux e Upscalers)
REPLICATE_API_TOKEN=

# Camada 3: Pós-processamento (Opcional caso use APIs externas)
